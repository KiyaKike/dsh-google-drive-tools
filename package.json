{
  "name": "dsh-google-drive-tools",
  "version": "0.1.0",
  "description": "Read-write Google Drive file tools for the DeepSeek Harness, served from an existing rclone mount",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "google-drive",
    "rclone",
    "tools"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
